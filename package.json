{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --alias:@shared=./shared",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc -b lib/db lib/api-client-react lib/api-zod --pretty false",
    "check:all": "tsc -b --force --pretty false",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:changed": "node scripts/check-changed-files.mjs format",
    "lint:changed": "node scripts/check-changed-files.mjs lint",
    "check:all:baseline": "node scripts/check-typescript-baseline.mjs",
    "test": "vitest run",
    "test:unit": "vitest run server/lib/__tests__/asyncHandler.test.ts server/lib/__tests__/excel.test.ts server/lib/__tests__/validate.test.ts server/__tests__/httpSafety.test.ts server/__tests__/authSecurity.test.ts server/__tests__/securityHeaders.test.ts server/__tests__/typescriptConfig.test.ts server/__tests__/frontendBuildSafety.test.ts server/__tests__/frontendInteractionSafety.test.ts server/__tests__/frontendResilience.test.ts server/__tests__/operationsDocumentation.test.ts server/__tests__/financialIntegrity.test.ts server/__tests__/accountingRegression.test.ts server/__tests__/accountingReports.test.ts server/__tests__/financialRepairSafety.test.ts server/__tests__/accountingIdempotencyRegression.test.ts server/__tests__/finalizedVoucherCorrection.test.ts server/__tests__/finalizedMutationPolicy.test.ts server/__tests__/motorcycleFinalizedSalePolicy.test.ts server/__tests__/motorcycleLifecyclePolicy.test.ts server/__tests__/bandwidthTelemetry.test.ts server/__tests__/heavyReadOptimization.test.ts server/__tests__/exportSafety.test.ts",
    "test:ci": "npm run test:unit",
    "test:integration": "vitest run server/__tests__/moto-rates-routes.test.ts server/__tests__/moto-rates-storage.test.ts server/__tests__/moto-rates-authed.test.ts",
    "test:financial-characterization": "vitest run server/__tests__/financialAudit.characterization.test.ts",
    "test:financial-integrity": "vitest run server/__tests__/financialIntegrity.test.ts",
    "test:financial-postgres": "tsx scripts/test-financial-integrity-postgres.ts",
    "test:accounting:unit": "vitest run server/__tests__/financialIntegrity.test.ts server/__tests__/accountingRegression.test.ts server/__tests__/financialRepairSafety.test.ts server/__tests__/accountingIdempotencyRegression.test.ts server/__tests__/finalizedVoucherCorrection.test.ts server/__tests__/finalizedMutationPolicy.test.ts",
    "test:accounting:integration": "tsx scripts/test-financial-integrity-postgres.ts",
    "test:accounting:reports": "vitest run server/__tests__/accountingReports.test.ts",
    "test:accounting:ci": "npm run test:accounting:unit && npm run test:accounting:reports",
    "test:watch": "vitest",
    "audit:financial": "tsx scripts/audit-financial-integrity.ts",
    "audit:supplier-companies": "tsx scripts/audit-supplier-company-assignments.ts",
    "repair:financial": "tsx scripts/repair-financial-integrity.ts",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify-moto-schema": "tsx scripts/verify-moto-schema.ts",
    "seed:dev": "tsx scripts/seed-dev.ts"
  },
