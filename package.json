    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.1",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.1",
    "framer-motion": "^11.13.1",
    "helmet": "^8.3.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "multer": "^2.2.0",
