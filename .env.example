# Core production configuration
NODE_ENV=production
DATABASE_URL=postgresql://app_user:replace-me@database-host:5432/erp_database
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
PGSSLMODE=require

# Hosting platform usually supplies these values.
# PORT=5000
# BUILD_VERSION=<exact-reviewed-git-commit>
# RENDER_GIT_COMMIT=<platform-provided>
# REPL_ID=<replit-provided>

# Optional integrations
# GEMINI_API_KEY=replace-me
# TRACKINGMORE_API_KEY=replace-me

# Bandwidth telemetry defaults
# DISABLE_BANDWIDTH_TELEMETRY=false
# BANDWIDTH_TELEMETRY_MAX_ROUTES=250
# BANDWIDTH_HEAVY_RESPONSE_BYTES=256000
# BANDWIDTH_SLOW_REQUEST_MILLIS=750
# BANDWIDTH_TELEMETRY_WINDOW_MINUTES=5

# Export safety defaults
# EXPORT_MAX_WORKSHEETS=50
# EXPORT_MAX_ROWS=250000
# EXPORT_MAX_CELLS=3000000
# EXPORT_MAX_CONCURRENT=2
# EXPORT_MAX_QUEUE=8
# EXPORT_QUEUE_TIMEOUT_MS=30000

# Financial repair variables are intentionally excluded from normal service
# configuration. See docs/operations/environment-variables.md before using
# FINANCIAL_REPAIR_SECRET or ALLOW_FINANCIAL_REPAIR.
